//@version=6
indicator("Swing Data Desktop", overlay=true)
plot(na, title="Compiler Anchor", display=display.none, editable=false)

// Note: The drawn levels (SMAs, PD high/low, opening ranges) only make sense on
// intraday charts, so their rendering is gated below by `if timeframe.isintraday`.
// The dashboard table (Rel Vol, LoD Distance, LoD Price) is computed on every
// timeframe so daily/weekly/monthly charts still show it.

// All inputs use display=display.none so their current values do NOT clutter
// the chart's status line at the top. Settings are still editable via the gear icon.
gp_visual = "Visual Layout Settings"
offset    = input.int(6, "Line Extension (Bars Ahead)", minval=0, group=gp_visual, display=display.none)
label_offset = input.int(1, "Label Gap From Line End", minval=0, group=gp_visual, display=display.none)
show_near_intraday_levels = input.bool(true, "Intraday: Only Show Nearby/Overlapped Levels", group=gp_visual, display=display.none)
near_level_pct = input.float(3.0, "Nearby Level Distance (%)", minval=0.0, step=0.1, group=gp_visual, display=display.none, tooltip="On intraday charts, only show daily levels that today's range has touched, or levels within this % of current price/today's low. Helps keep possible U&R levels visible without showing every far-away level.")
use_visible_replay = input.bool(true, "Use Last Complete Visible RTH Day", group=gp_visual, display=display.none, tooltip="When enabled, labels, lines, and table values use the latest full regular-session day visible on screen. A partially visible next day is ignored.")

gp_sma    = "Daily Moving Averages"
show_5    = input.bool(false, "Show 5D SMA",   group=gp_sma, display=display.none)
col_5     = input.color(color.blue, "",        group=gp_sma, display=display.none)
w_5       = input.int(1, "Width", minval=1, maxval=5, group=gp_sma, display=display.none)
style_5   = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_sma, display=display.none)

// 10D SMA defaults to ON; user added it to their daily chart in light red.
show_10   = input.bool(true,  "Show 10D SMA", group=gp_sma, display=display.none)
col_10    = input.color(#ff9999, "",          group=gp_sma, display=display.none)
w_10      = input.int(1, "Width", minval=1, maxval=5, group=gp_sma, display=display.none)
style_10  = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_sma, display=display.none)

// Color defaults below match the user's daily-chart "Moving Averages" indicator setup.
show_20   = input.bool(true,  "Show 20D SMA", group=gp_sma, display=display.none)
col_20    = input.color(color.rgb(180, 131, 59), "",     group=gp_sma, display=display.none)
w_20      = input.int(1, "Width", minval=1, maxval=5, group=gp_sma, display=display.none)
style_20  = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_sma, display=display.none)

show_50   = input.bool(true,  "Show 50D SMA", group=gp_sma, display=display.none)
col_50    = color.rgb(102, 178, 255)
w_50      = input.int(2, "Width", minval=1, maxval=5, group=gp_sma, display=display.none)
style_50  = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_sma, display=display.none)

show_150  = input.bool(true,  "Show 150D SMA", group=gp_sma, display=display.none)
col_150   = color.rgb(190, 150, 255)
w_150     = input.int(2, "Width", minval=1, maxval=5, group=gp_sma, display=display.none)
style_150 = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_sma, display=display.none)

show_200  = input.bool(true,  "Show 200D SMA",group=gp_sma, display=display.none)
col_200   = input.color(color.purple, "",     group=gp_sma, display=display.none)
w_200     = input.int(2, "Width", minval=1, maxval=5, group=gp_sma, display=display.none)
style_200 = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_sma, display=display.none)

gp_ema    = "Daily Exponential Moving Averages"
show_ema10  = input.bool(true,  "Show 10D EMA", group=gp_ema, display=display.none)
col_ema10   = input.color(color.red, "",        group=gp_ema, display=display.none)
w_ema10     = input.int(1, "Width", minval=1, maxval=5, group=gp_ema, display=display.none)
style_ema10 = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_ema, display=display.none)

show_ema20  = input.bool(true,  "Show 20D EMA", group=gp_ema, display=display.none)
col_ema20   = input.color(color.orange, "",      group=gp_ema, display=display.none)
w_ema20     = input.int(1, "Width", minval=1, maxval=5, group=gp_ema, display=display.none)
style_ema20 = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_ema, display=display.none)

show_ema50  = input.bool(true,  "Show 50D EMA", group=gp_ema, display=display.none)
col_ema50   = color.blue
w_ema50     = input.int(1, "Width", minval=1, maxval=5, group=gp_ema, display=display.none)
style_ema50 = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_ema, display=display.none)

gp_hl     = "Previous Day High / Low"
show_h    = input.bool(true,  "Show Prev High", group=gp_hl, display=display.none)
col_h     = input.color(color.green, "",        group=gp_hl, display=display.none)
w_h       = input.int(1, "Width", minval=1, maxval=5, group=gp_hl, display=display.none)
style_h   = input.string("Dashed", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_hl, display=display.none)

show_l    = input.bool(true,  "Show Prev Low",  group=gp_hl, display=display.none)
col_l     = input.color(color.maroon, "",       group=gp_hl, display=display.none)
w_l       = input.int(1, "Width", minval=1, maxval=5, group=gp_hl, display=display.none)
style_l   = input.string("Dashed", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_hl, display=display.none)

gp_or5    = "5-Min Opening Range"
show_or5  = input.bool(true,  "Show 5m OR",     group=gp_or5, display=display.none)
col_or5   = input.color(color.teal, "",         group=gp_or5, display=display.none)
w_or5     = input.int(1, "Width", minval=1, maxval=5, group=gp_or5, display=display.none)
style_or5 = input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_or5, display=display.none)

gp_or30   = "30-Min Opening Range"
show_or30 = input.bool(true,  "Show 30m OR",    group=gp_or30, display=display.none)
col_or30  = input.color(color.fuchsia, "",      group=gp_or30, display=display.none)
w_or30    = input.int(1, "Width", minval=1, maxval=5, group=gp_or30, display=display.none)
style_or30 = input.string("Dotted", "Style", options=["Solid", "Dashed", "Dotted"], group=gp_or30, display=display.none)

gp_lbl       = "Label Anti-Overlap"
lbl_min_gap_pct = input.float(0.6, "Min Label Gap (% of price)", minval=0.0, step=0.1, group=gp_lbl, display=display.none, tooltip="When two labels are vertically closer than this %, the second one is pushed further right (and its line extended) so they don't overlap. Increase if labels still overlap; set to 0 to disable.")
lbl_step_bars   = input.int(3, "Label Stagger (bars)", minval=1, group=gp_lbl, display=display.none, tooltip="How many bars to the right each colliding label gets pushed. Keep small so labels stay close to their lines.")
lbl_max_slots   = input.int(2, "Max Label Stagger Slots", minval=1, maxval=4, group=gp_lbl, display=display.none, tooltip="Caps chained label staggering so labels do not drift far to the right.")

gp_tbl    = "Data Dashboard Layout"
tbl_size  = input.string('Small', "Size", options=['Tiny', 'Small', 'Normal', 'Large'], group=gp_tbl, display=display.none)
show_info_table = true
tbl_text_col = color.teal
tbl_extended_col = color.red
atr_len = 20
atr_ma_len = 50
atr_multiple_detection = 10.0
dot_col = color.yellow
rvol_intraday_days = 5

// --- SESSION TRACKING & OPENING RANGE ---
// Explicit time-of-day check for the US equity regular cash session (9:30 AM – 4:00 PM ET).
// We use this instead of `session.ismarket` / `session.isfirstbar_regular` because those
// built-ins can return true for pre-market bars on certain symbols/exchanges, which leaks
// extended-hours data into PD High/Low. The explicit check is unambiguous.
is_rth_bar      = not na(time(timeframe.period, "0930-1600", "America/New_York"))
is_rth_bar_prev = not na(time(timeframe.period, "0930-1600", "America/New_York")[1])
is_new_exchange_day = timeframe.isintraday and ta.change(time("D")) != 0
rth_close_time = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 16, 0)
is_rth_close_bar = is_rth_bar and time_close >= rth_close_time

// With extended hours on, the 9:30 bar follows pre-market.
// With extended hours off, the 9:30 bar follows the previous day's last RTH bar.
var int session_start_time = na
var int session_start_bar = na
var int session_last_rth_bar = na
var float session_hod = na
var float session_lod = na
var bool session_lod_ready = false
is_new_day = is_rth_bar and (not is_rth_bar_prev or is_new_exchange_day)
if is_new_exchange_day and not is_rth_bar
    session_start_time := na
    session_start_bar := na
    session_last_rth_bar := na
    session_hod := na
    session_lod := na
    session_lod_ready := false
else if is_new_day
    session_start_time := time
    session_start_bar := bar_index
    session_last_rth_bar := bar_index
    session_lod_ready := true
else if timeframe.isintraday and is_rth_bar and na(session_start_time)
    session_start_time := time
    session_start_bar := bar_index
    session_last_rth_bar := bar_index
    session_hod := high
    session_lod := low
    session_lod_ready := true
else if is_rth_bar
    session_last_rth_bar := bar_index

// --- GLOBAL SECURITY DATA REQUESTS (MAs) ---
// No [1] offset — request.security with default lookahead_off already returns
// the last *closed* daily bar's value, which matches a standard daily SMA overlay.
// lookahead_on: include TODAY's developing daily bar in the MA value so the
// numbers on intraday match what the daily chart shows live (not yesterday's value).
// Safe here because labels only render on the latest bar.
[sma5_d, sma10_d, sma20_d, sma50_d, sma150_d, sma200_d, ema10_d, ema20_d, ema50_d, atr_ma_d] = request.security(syminfo.tickerid, "D", [ta.sma(close, 5), ta.sma(close, 10), ta.sma(close, 20), ta.sma(close, 50), ta.sma(close, 150), ta.sma(close, 200), ta.ema(close, 10), ta.ema(close, 20), ta.ema(close, 50), ta.sma(close, atr_ma_len)], lookahead=barmerge.lookahead_on)

time_elapsed_ms = time - session_start_time

var float or5_high  = na
var float or5_low   = na
var float or30_high = na
var float or30_low  = na

var float running_today_high = na
var float running_today_low  = na
var float prev_high          = na
var float prev_low           = na
var float ppd_low            = na

if is_new_day
    prev_high := running_today_high
    ppd_low   := prev_low
    prev_low  := running_today_low

    running_today_high := high
    running_today_low  := low

    or5_high  := na
    or5_low   := na
    or30_high := na
    or30_low  := na
    session_hod := high
    session_lod := low
    session_lod_ready := true
else if is_rth_bar
    // Only update during the regular cash session (9:30 AM – 4:00 PM ET).
    // Pre-market and after-hours bars are skipped so they don't contaminate
    // running_today_high / running_today_low, which become tomorrow's PD High/Low.
    running_today_high := math.max(running_today_high, high)
    running_today_low  := math.min(running_today_low, low)
    session_hod := math.max(session_hod, high)
    session_lod := math.min(session_lod, low)

if timeframe.isintraday and timeframe.multiplier < 30
    if time_elapsed_ms < 300000
        or5_high := na(or5_high) ? high : math.max(or5_high, high)
        or5_low  := na(or5_low)  ? low  : math.min(or5_low, low)
    if time_elapsed_ms < 1800000
        or30_high := na(or30_high) ? high : math.max(or30_high, high)
        or30_low  := na(or30_low)  ? low  : math.min(or30_low, low)

lower_tf = timeframe.isintraday and timeframe.multiplier >= 30 ? "1" : timeframe.isintraday ? str.tostring(timeframe.multiplier) : "1"
lower_highs  = request.security_lower_tf(syminfo.tickerid, lower_tf, high)
lower_lows   = request.security_lower_tf(syminfo.tickerid, lower_tf, low)
lower_times  = request.security_lower_tf(syminfo.tickerid, lower_tf, time)
lower_market = request.security_lower_tf(syminfo.tickerid, lower_tf, session.ismarket)

// --- DAILY-CHART REGULAR-SESSION LOW ---
// On a non-intraday chart, each chart bar is one full day (or week/month).
// TradingView's daily bar `low` includes extended hours when EH is toggled on for the
// chart, so we can't trust it. Instead we walk the 1-min sub-bars and pick the min
// from bars where session.ismarket was true.
var float daily_rth_low = na
if not timeframe.isintraday
    daily_rth_low := na
    if array.size(lower_lows) > 0
        for i = 0 to array.size(lower_lows) - 1
            if array.get(lower_market, i)
                bar_low = array.get(lower_lows, i)
                daily_rth_low := na(daily_rth_low) ? bar_low : math.min(daily_rth_low, bar_low)

// Gated by is_rth_bar so pre-market and after-hours chart bars don't
// feed their sub-bars into running_today_high / session_hod / etc.
if timeframe.isintraday and timeframe.multiplier >= 5 and is_rth_bar and array.size(lower_highs) > 0
    for i = 0 to array.size(lower_highs) - 1
        bar_time = array.get(lower_times, i)
        bar_high = array.get(lower_highs, i)
        bar_low  = array.get(lower_lows, i)

        if bar_time >= session_start_time
            session_hod := na(session_hod) ? bar_high : math.max(session_hod, bar_high)
            session_lod := na(session_lod) ? bar_low  : math.min(session_lod, bar_low)
            running_today_high := na(running_today_high) ? bar_high : math.max(running_today_high, bar_high)
            running_today_low  := na(running_today_low)  ? bar_low  : math.min(running_today_low, bar_low)

        elapsed = bar_time - session_start_time
        if elapsed < 300000
            or5_high := na(or5_high) ? bar_high : math.max(or5_high, bar_high)
            or5_low  := na(or5_low)  ? bar_low  : math.min(or5_low, bar_low)
        if elapsed < 1800000
            or30_high := na(or30_high) ? bar_high : math.max(or30_high, bar_high)
            or30_low  := na(or30_low)  ? bar_low  : math.min(or30_low, bar_low)

// --- DAILY TIMEFRAME SECURITY CALL (for LoD-distance and daily-chart fallback data) ---
[d_close, d_volume, d_vol_ma50, d_atr] = request.security(syminfo.tickerid, "D", [close, volume, ta.sma(volume, 50), ta.atr(atr_len)])

// --- INTRADAY RELATIVE VOLUME ---
// RTH same-time RVOL: today's cumulative regular-session volume at this
// minute-of-session vs the average cumulative volume at the same minute over
// recent regular sessions. Extended-hours bars are ignored.
rvol_session_minutes = 390
rvol_slot_count = rvol_session_minutes * (rvol_intraday_days + 1)
rvol_start_ts = timestamp("America/New_York", year(time, "America/New_York"), month(time, "America/New_York"), dayofmonth(time, "America/New_York"), 9, 30)
rvol_elapsed_min = int(math.floor((time - rvol_start_ts) / 60000))
rvol_minute_slot = math.max(0, math.min(rvol_session_minutes - 1, rvol_elapsed_min))

var float rth_cum_vol = na
var rvol_cum_by_minute = array.new_float(rvol_slot_count, na)

if is_new_day
    rth_cum_vol := volume
    for i = 0 to rvol_session_minutes - 1
        for d = 0 to rvol_intraday_days - 1
            array.set(rvol_cum_by_minute, d * rvol_session_minutes + i, array.get(rvol_cum_by_minute, (d + 1) * rvol_session_minutes + i))
        array.set(rvol_cum_by_minute, rvol_intraday_days * rvol_session_minutes + i, na)
else if timeframe.isintraday and is_rth_bar
    rth_cum_vol := nz(rth_cum_vol[1]) + volume

if timeframe.isintraday and is_rth_bar
    array.set(rvol_cum_by_minute, rvol_intraday_days * rvol_session_minutes + rvol_minute_slot, rth_cum_vol)

float hist_cum_vol = 0.0
int hist_count = 0
if timeframe.isintraday and is_rth_bar
    for d = 0 to rvol_intraday_days - 1
        past_cum_vol = array.get(rvol_cum_by_minute, d * rvol_session_minutes + rvol_minute_slot)
        if not na(past_cum_vol) and past_cum_vol > 0
            hist_cum_vol += past_cum_vol
            hist_count += 1

intraday_rvol = timeframe.isintraday and is_rth_bar and hist_count > 0 ? rth_cum_vol / (hist_cum_vol / hist_count) : na
var float last_intraday_rvol = na
if not na(intraday_rvol)
    last_intraday_rvol := intraday_rvol


// --- DASHBOARD CALCULATIONS (timeframe-aware) ---
// On intraday: use the daily security data + session-tracked low.
// On daily/weekly/monthly: use the current bar's values directly so the table makes
// sense on those timeframes too. (`session_lod` already collapses to `low` per bar
// on non-intraday because is_new_day fires every bar there.)
chart_close   = timeframe.isintraday ? d_close    : close
chart_vol     = timeframe.isintraday ? d_volume   : volume
chart_vol_ma  = timeframe.isintraday ? d_vol_ma50 : ta.sma(volume, 50)[1]
chart_atr     = timeframe.isintraday ? d_atr      : ta.atr(atr_len)
// On intraday, only use the live RTH session low. If it is not ready, the table
// blanks LoD values rather than falling back to stale data.
chart_lod     = timeframe.isintraday ? session_lod : na(daily_rth_low) ? low : daily_rth_low
chart_ref_ma  = timeframe.isintraday ? atr_ma_d : ta.sma(close, atr_ma_len)

daily_rvol = (chart_vol_ma > 0) ? (chart_vol / chart_vol_ma) * 100 : na             // daily fallback: today's vol vs 50-period avg, %
calc_rvol = timeframe.isintraday ? last_intraday_rvol * 100 : daily_rvol
lodd_close = timeframe.isintraday ? close : chart_close
calc_lodd = (chart_atr > 0)    ? ((lodd_close - chart_lod) / chart_atr) * 100 : na // distance from session low, % of ATR
calc_atr_pct = (chart_close > 0) ? (chart_atr / chart_close) * 100 : na
calc_gain_from_ma = (chart_ref_ma > 0) ? ((chart_close - chart_ref_ma) / chart_ref_ma) * 100 : na
calc_atr_mult_from_ma = (calc_atr_pct != 0) ? (calc_gain_from_ma / calc_atr_pct) : na
is_atr_extended = calc_atr_mult_from_ma > atr_multiple_detection

plotshape(is_atr_extended ? high * 1.01 : na, title="ATR Multiple Dot", style=shape.circle, location=location.absolute, size=size.tiny, color=dot_col, display=display.pane, editable=false)


// --- LINES & LABELS ---
var line l_sma5   = na
var line l_sma10  = na
var line l_sma20  = na
var line l_sma50  = na
var line l_sma150 = na
var line l_sma200 = na
var line l_ema10  = na
var line l_ema20  = na
var line l_ema50  = na
var line l_high   = na
var line l_low    = na
var line l_ppd_low = na
var line l_or5h   = na
var line l_or30h  = na

var label lbl_sma5   = na
var label lbl_sma10  = na
var label lbl_sma20  = na
var label lbl_sma50  = na
var label lbl_sma150 = na
var label lbl_sma200 = na
var label lbl_ema10  = na
var label lbl_ema20  = na
var label lbl_ema50  = na
var label lbl_high   = na
var label lbl_low    = na
var label lbl_ppd_low = na
var label lbl_or5h   = na
var label lbl_or30h  = na

get_text(string name, float val) =>
    name + " (" + str.tostring(val, "#.##") + ")"

get_name(string name) =>
    name

get_style(string str_style) =>
    str_style == "Dashed" ? line.style_dashed : str_style == "Dotted" ? line.style_dotted : line.style_solid

// Clamp a price to within `max_dist` of `anchor` — used so labels for far-away
// SMAs (like 200D) get pulled toward the current-price cluster while their
// underlying line still draws at the true price.
clamp_to_band(float p, float anchor, float max_dist) =>
    (p - anchor) > max_dist  ? anchor + max_dist :
      (anchor - p) > max_dist ? anchor - max_dist : p

level_is_relevant_at(float p, float anchor_close, float anchor_lod, float anchor_hod) =>
    near_band = anchor_close * (near_level_pct / 100.0)
    overlaps_today = not na(p) and not na(anchor_lod) and not na(anchor_hod) and p >= anchor_lod and p <= anchor_hod
    near_close = not na(p) and math.abs(p - anchor_close) <= near_band
    near_day_low = not na(p) and not na(anchor_lod) and math.abs(p - anchor_lod) <= near_band
    not show_near_intraday_levels or not timeframe.isintraday or overlaps_today or near_close or near_day_low

level_is_relevant(float p) =>
    level_is_relevant_at(p, close, session_lod, session_hod)


// --- LABEL ANTI-OVERLAP HELPERS (horizontal stagger, parallel arrays) ---
add_lbl(array<line> lns, array<label> lbls, array<float> prices, line ln, label lbl, float price) =>
    if not na(ln) and not na(lbl) and not na(price)
        array.push(lns, ln)
        array.push(lbls, lbl)
        array.push(prices, price)

stagger_labels(array<line> lns, array<label> lbls, array<float> prices, float min_gap, int base_x, int step_bars, int max_slots, int line_gap) =>
    n = array.size(prices)
    // bubble sort all three arrays together by price ascending
    if n > 1
        for i = 0 to n - 1
            for j = 0 to n - 2 - i
                if array.get(prices, j) > array.get(prices, j + 1)
                    p_tmp = array.get(prices, j)
                    array.set(prices, j, array.get(prices, j + 1))
                    array.set(prices, j + 1, p_tmp)
                    ln_tmp = array.get(lns, j)
                    array.set(lns, j, array.get(lns, j + 1))
                    array.set(lns, j + 1, ln_tmp)
                    lb_tmp = array.get(lbls, j)
                    array.set(lbls, j, array.get(lbls, j + 1))
                    array.set(lbls, j + 1, lb_tmp)
    // walk low->high: chain a horizontal slot offset whenever the price gap is under min_gap
    float last_price = na
    int   slot       = 0
    for i = 0 to n - 1
        p  = array.get(prices, i)
        ln = array.get(lns, i)
        lb = array.get(lbls, i)
        if na(last_price) or (p - last_price) >= min_gap
            slot := 0
        else
            slot := math.min(slot + 1, max_slots)
        new_x = base_x + slot * step_bars
        line.set_x2(ln, new_x - line_gap)
        label.set_x(lb, new_x)
        last_price := p

is_right_visible_bar = time == chart.right_visible_bar_time
is_complete_visible_rth_day = timeframe.isintraday and is_rth_close_bar and not na(session_start_time) and session_start_time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
is_visible_rth_day_bar = timeframe.isintraday and is_rth_bar and not na(session_start_time) and time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time

var bool found_complete_visible_rth_day = false
var int anchor_session_start_bar = na
var int anchor_bar_index = na
var int anchor_session_start_time = na
var float anchor_close = na
var float anchor_session_hod = na
var float anchor_session_lod = na
var float anchor_sma5_d = na
var float anchor_sma10_d = na
var float anchor_sma20_d = na
var float anchor_sma50_d = na
var float anchor_sma150_d = na
var float anchor_sma200_d = na
var float anchor_ema10_d = na
var float anchor_ema20_d = na
var float anchor_ema50_d = na
var float anchor_prev_high = na
var float anchor_prev_low = na
var float anchor_ppd_low = na
var float anchor_or5_high = na
var float anchor_or30_high = na
var float anchor_calc_rvol = na
var float anchor_calc_lodd = na
var float anchor_chart_lod = na
var float anchor_calc_atr_pct = na
var float anchor_calc_gain_from_ma = na
var float anchor_calc_atr_mult_from_ma = na
var bool anchor_is_atr_extended = false
var bool found_visible_rth_day = false
var int latest_session_start_bar = na
var int latest_bar_index = na
var int latest_session_start_time = na
var float latest_close = na
var float latest_session_hod = na
var float latest_session_lod = na
var float latest_sma5_d = na
var float latest_sma10_d = na
var float latest_sma20_d = na
var float latest_sma50_d = na
var float latest_sma150_d = na
var float latest_sma200_d = na
var float latest_ema10_d = na
var float latest_ema20_d = na
var float latest_ema50_d = na
var float latest_prev_high = na
var float latest_prev_low = na
var float latest_ppd_low = na
var float latest_or5_high = na
var float latest_or30_high = na
var float latest_calc_rvol = na
var float latest_calc_lodd = na
var float latest_chart_lod = na
var float latest_calc_atr_pct = na
var float latest_calc_gain_from_ma = na
var float latest_calc_atr_mult_from_ma = na
var bool latest_is_atr_extended = false
if barstate.isfirst
    found_complete_visible_rth_day := false
    found_visible_rth_day := false
if is_visible_rth_day_bar
    found_visible_rth_day := true
    latest_session_start_bar := session_start_bar
    latest_bar_index := bar_index
    latest_session_start_time := session_start_time
    latest_close := close
    latest_session_hod := session_hod
    latest_session_lod := session_lod
    latest_sma5_d := sma5_d
    latest_sma10_d := sma10_d
    latest_sma20_d := sma20_d
    latest_sma50_d := sma50_d
    latest_sma150_d := sma150_d
    latest_sma200_d := sma200_d
    latest_ema10_d := ema10_d
    latest_ema20_d := ema20_d
    latest_ema50_d := ema50_d
    latest_prev_high := prev_high
    latest_prev_low := prev_low
    latest_ppd_low := ppd_low
    latest_or5_high := or5_high
    latest_or30_high := or30_high
    latest_calc_rvol := calc_rvol
    latest_calc_lodd := calc_lodd
    latest_chart_lod := chart_lod
    latest_calc_atr_pct := calc_atr_pct
    latest_calc_gain_from_ma := calc_gain_from_ma
    latest_calc_atr_mult_from_ma := calc_atr_mult_from_ma
    latest_is_atr_extended := is_atr_extended
if is_complete_visible_rth_day
    found_complete_visible_rth_day := true
    anchor_session_start_bar := session_start_bar
    anchor_bar_index := bar_index
    anchor_session_start_time := session_start_time
    anchor_close := close
    anchor_session_hod := session_hod
    anchor_session_lod := session_lod
    anchor_sma5_d := sma5_d
    anchor_sma10_d := sma10_d
    anchor_sma20_d := sma20_d
    anchor_sma50_d := sma50_d
    anchor_sma150_d := sma150_d
    anchor_sma200_d := sma200_d
    anchor_ema10_d := ema10_d
    anchor_ema20_d := ema20_d
    anchor_ema50_d := ema50_d
    anchor_prev_high := prev_high
    anchor_prev_low := prev_low
    anchor_ppd_low := ppd_low
    anchor_or5_high := or5_high
    anchor_or30_high := or30_high
    anchor_calc_rvol := calc_rvol
    anchor_calc_lodd := calc_lodd
    anchor_chart_lod := chart_lod
    anchor_calc_atr_pct := calc_atr_pct
    anchor_calc_gain_from_ma := calc_gain_from_ma
    anchor_calc_atr_mult_from_ma := calc_atr_mult_from_ma
    anchor_is_atr_extended := is_atr_extended
use_latest_visible_rth_day = use_visible_replay and timeframe.isintraday and barstate.islast and is_rth_bar and found_visible_rth_day
use_complete_visible_rth_day = use_visible_replay and timeframe.isintraday and found_complete_visible_rth_day and not use_latest_visible_rth_day
is_data_anchor_bar = use_visible_replay ? (timeframe.isintraday ? is_right_visible_bar : is_right_visible_bar) : barstate.islast
active_session_start_bar = use_latest_visible_rth_day ? latest_session_start_bar : use_complete_visible_rth_day ? anchor_session_start_bar : session_start_bar
active_bar_index = use_latest_visible_rth_day ? latest_bar_index : use_complete_visible_rth_day ? anchor_bar_index : bar_index
active_close = use_latest_visible_rth_day ? latest_close : use_complete_visible_rth_day ? anchor_close : close
active_session_hod = use_latest_visible_rth_day ? latest_session_hod : use_complete_visible_rth_day ? anchor_session_hod : session_hod
active_session_lod = use_latest_visible_rth_day ? latest_session_lod : use_complete_visible_rth_day ? anchor_session_lod : session_lod
active_sma5_d = use_latest_visible_rth_day ? latest_sma5_d : use_complete_visible_rth_day ? anchor_sma5_d : sma5_d
active_sma10_d = use_latest_visible_rth_day ? latest_sma10_d : use_complete_visible_rth_day ? anchor_sma10_d : sma10_d
active_sma20_d = use_latest_visible_rth_day ? latest_sma20_d : use_complete_visible_rth_day ? anchor_sma20_d : sma20_d
active_sma50_d = use_latest_visible_rth_day ? latest_sma50_d : use_complete_visible_rth_day ? anchor_sma50_d : sma50_d
active_sma150_d = use_latest_visible_rth_day ? latest_sma150_d : use_complete_visible_rth_day ? anchor_sma150_d : sma150_d
active_sma200_d = use_latest_visible_rth_day ? latest_sma200_d : use_complete_visible_rth_day ? anchor_sma200_d : sma200_d
active_ema10_d = use_latest_visible_rth_day ? latest_ema10_d : use_complete_visible_rth_day ? anchor_ema10_d : ema10_d
active_ema20_d = use_latest_visible_rth_day ? latest_ema20_d : use_complete_visible_rth_day ? anchor_ema20_d : ema20_d
active_ema50_d = use_latest_visible_rth_day ? latest_ema50_d : use_complete_visible_rth_day ? anchor_ema50_d : ema50_d
active_prev_high = use_latest_visible_rth_day ? latest_prev_high : use_complete_visible_rth_day ? anchor_prev_high : prev_high
active_prev_low = use_latest_visible_rth_day ? latest_prev_low : use_complete_visible_rth_day ? anchor_prev_low : prev_low
active_ppd_low = use_latest_visible_rth_day ? latest_ppd_low : use_complete_visible_rth_day ? anchor_ppd_low : ppd_low
active_or5_high = use_latest_visible_rth_day ? latest_or5_high : use_complete_visible_rth_day ? anchor_or5_high : or5_high
active_or30_high = use_latest_visible_rth_day ? latest_or30_high : use_complete_visible_rth_day ? anchor_or30_high : or30_high
active_calc_rvol = use_latest_visible_rth_day ? latest_calc_rvol : use_complete_visible_rth_day ? anchor_calc_rvol : calc_rvol
active_calc_lodd = use_latest_visible_rth_day ? latest_calc_lodd : use_complete_visible_rth_day ? anchor_calc_lodd : calc_lodd
active_chart_lod = use_latest_visible_rth_day ? latest_chart_lod : use_complete_visible_rth_day ? anchor_chart_lod : chart_lod
active_calc_atr_pct = use_latest_visible_rth_day ? latest_calc_atr_pct : use_complete_visible_rth_day ? anchor_calc_atr_pct : calc_atr_pct
active_calc_gain_from_ma = use_latest_visible_rth_day ? latest_calc_gain_from_ma : use_complete_visible_rth_day ? anchor_calc_gain_from_ma : calc_gain_from_ma
active_calc_atr_mult_from_ma = use_latest_visible_rth_day ? latest_calc_atr_mult_from_ma : use_complete_visible_rth_day ? anchor_calc_atr_mult_from_ma : calc_atr_mult_from_ma
active_is_atr_extended = use_latest_visible_rth_day ? latest_is_atr_extended : use_complete_visible_rth_day ? anchor_is_atr_extended : is_atr_extended
show_ppd_low_line = show_l and not na(active_ppd_low) and not na(active_prev_low) and active_ppd_low < active_prev_low and (active_prev_low - active_ppd_low) / active_prev_low < 0.03
active_rth_end_bar = use_latest_visible_rth_day ? latest_bar_index : use_complete_visible_rth_day ? anchor_bar_index : session_last_rth_bar
target_base_index = timeframe.isintraday and not na(active_rth_end_bar) ? active_rth_end_bar : active_bar_index
target_index = target_base_index + offset
target_label_index = target_index + label_offset
should_create_levels = timeframe.isintraday and not na(active_session_start_bar) and is_data_anchor_bar

// --- LINE/LABEL DRAWING (intraday charts only) ---
if should_create_levels
    line.delete(l_sma5)
    label.delete(lbl_sma5)
    line.delete(l_sma10)
    label.delete(lbl_sma10)
    line.delete(l_sma20)
    label.delete(lbl_sma20)
    line.delete(l_sma50)
    label.delete(lbl_sma50)
    line.delete(l_sma150)
    label.delete(lbl_sma150)
    line.delete(l_sma200)
    label.delete(lbl_sma200)
    line.delete(l_ema10)
    label.delete(lbl_ema10)
    line.delete(l_ema20)
    label.delete(lbl_ema20)
    line.delete(l_ema50)
    label.delete(lbl_ema50)
    line.delete(l_high)
    label.delete(lbl_high)
    line.delete(l_low)
    label.delete(lbl_low)
    line.delete(l_ppd_low)
    label.delete(lbl_ppd_low)
    line.delete(l_or5h)
    label.delete(lbl_or5h)
    line.delete(l_or30h)
    label.delete(lbl_or30h)

    if show_5 and level_is_relevant_at(active_sma5_d, active_close, active_session_lod, active_session_hod)
        l_sma5    := line.new(active_session_start_bar, active_sma5_d, target_index, active_sma5_d, color=col_5, width=w_5, style=get_style(style_5))
        lbl_sma5  := label.new(target_label_index, active_sma5_d, get_name("5D SMA"), color=color.new(color.black, 100), textcolor=col_5, style=label.style_label_left, tooltip=get_text("5D SMA", active_sma5_d))
    if show_20 and level_is_relevant_at(active_sma20_d, active_close, active_session_lod, active_session_hod)
        l_sma20   := line.new(active_session_start_bar, active_sma20_d, target_index, active_sma20_d, color=col_20, width=w_20, style=get_style(style_20))
        lbl_sma20 := label.new(target_label_index, active_sma20_d, get_name("20D SMA"), color=color.new(color.black, 100), textcolor=col_20, style=label.style_label_left, tooltip=get_text("20D SMA", active_sma20_d))
    if show_10 and level_is_relevant_at(active_sma10_d, active_close, active_session_lod, active_session_hod)
        l_sma10   := line.new(active_session_start_bar, active_sma10_d, target_index, active_sma10_d, color=col_10, width=w_10, style=get_style(style_10))
        lbl_sma10 := label.new(target_label_index, active_sma10_d, get_name("10D SMA"), color=color.new(color.black, 100), textcolor=col_10, style=label.style_label_left, tooltip=get_text("10D SMA", active_sma10_d))
    if show_50 and level_is_relevant_at(active_sma50_d, active_close, active_session_lod, active_session_hod)
        l_sma50   := line.new(active_session_start_bar, active_sma50_d, target_index, active_sma50_d, color=col_50, width=w_50, style=get_style(style_50))
        lbl_sma50 := label.new(target_label_index, active_sma50_d, get_name("50D SMA"), color=color.new(color.black, 100), textcolor=col_50, style=label.style_label_left, tooltip=get_text("50D SMA", active_sma50_d))
    if show_150 and level_is_relevant_at(active_sma150_d, active_close, active_session_lod, active_session_hod)
        l_sma150  := line.new(active_session_start_bar, active_sma150_d, target_index, active_sma150_d, color=col_150, width=w_150, style=get_style(style_150))
        lbl_sma150:= label.new(target_label_index, active_sma150_d, get_name("150D SMA"), color=color.new(color.black, 100), textcolor=col_150, style=label.style_label_left, tooltip=get_text("150D SMA", active_sma150_d))
    if show_200 and level_is_relevant_at(active_sma200_d, active_close, active_session_lod, active_session_hod)
        l_sma200  := line.new(active_session_start_bar, active_sma200_d, target_index, active_sma200_d, color=col_200, width=w_200, style=get_style(style_200))
        lbl_sma200:= label.new(target_label_index, active_sma200_d, get_name("200D SMA"), color=color.new(color.black, 100), textcolor=col_200, style=label.style_label_left, tooltip=get_text("200D SMA", active_sma200_d))

    // EMAs — skip the EMA entirely if it's within ~0.3% of price of its sibling SMA
    // (10D EMA vs 10D SMA, 20D EMA vs 20D SMA). When MAs overlap that closely the
    // labels would just stack on top of each other, so showing one is enough.
    ema_skip_gap = active_close * 0.003
    if show_ema10 and level_is_relevant_at(active_ema10_d, active_close, active_session_lod, active_session_hod) and (not show_10 or math.abs(active_ema10_d - active_sma10_d) > ema_skip_gap)
        l_ema10   := line.new(active_session_start_bar, active_ema10_d, target_index, active_ema10_d, color=col_ema10, width=w_ema10, style=get_style(style_ema10))
        lbl_ema10 := label.new(target_label_index, active_ema10_d, get_name("10D EMA"), color=color.new(color.black, 100), textcolor=col_ema10, style=label.style_label_left, tooltip=get_text("10D EMA", active_ema10_d))
    if show_ema20 and level_is_relevant_at(active_ema20_d, active_close, active_session_lod, active_session_hod) and (not show_20 or math.abs(active_ema20_d - active_sma20_d) > ema_skip_gap)
        l_ema20   := line.new(active_session_start_bar, active_ema20_d, target_index, active_ema20_d, color=col_ema20, width=w_ema20, style=get_style(style_ema20))
        lbl_ema20 := label.new(target_label_index, active_ema20_d, get_name("20D EMA"), color=color.new(color.black, 100), textcolor=col_ema20, style=label.style_label_left, tooltip=get_text("20D EMA", active_ema20_d))
    if show_ema50 and level_is_relevant_at(active_ema50_d, active_close, active_session_lod, active_session_hod) and (not show_50 or math.abs(active_ema50_d - active_sma50_d) > ema_skip_gap)
        l_ema50   := line.new(active_session_start_bar, active_ema50_d, target_index, active_ema50_d, color=col_ema50, width=w_ema50, style=get_style(style_ema50))
        lbl_ema50 := label.new(target_label_index, active_ema50_d, get_name("50D EMA"), color=color.new(color.black, 100), textcolor=col_ema50, style=label.style_label_left, tooltip=get_text("50D EMA", active_ema50_d))

    if show_h and not na(active_prev_high) and level_is_relevant_at(active_prev_high, active_close, active_session_lod, active_session_hod)
        l_high   := line.new(active_session_start_bar, active_prev_high, target_index, active_prev_high, color=col_h, width=w_h, style=get_style(style_h))
        lbl_high := label.new(target_label_index, active_prev_high, get_text("PD High", active_prev_high), color=color.new(color.black, 100), textcolor=col_h, style=label.style_label_left, tooltip=get_text("PD High", active_prev_high))
    if show_l and not na(active_prev_low) and level_is_relevant_at(active_prev_low, active_close, active_session_lod, active_session_hod)
        l_low    := line.new(active_session_start_bar, active_prev_low, target_index, active_prev_low, color=col_l, width=w_l, style=get_style(style_l))
        lbl_low  := label.new(target_label_index, active_prev_low, get_text("PD Low", active_prev_low), color=color.new(color.black, 100), textcolor=col_l, style=label.style_label_left, tooltip=get_text("PD Low", active_prev_low))
    if show_ppd_low_line and level_is_relevant_at(active_ppd_low, active_close, active_session_lod, active_session_hod)
        l_ppd_low   := line.new(active_session_start_bar, active_ppd_low, target_index, active_ppd_low, color=col_l, width=w_l, style=get_style(style_l))
        lbl_ppd_low := label.new(target_label_index, active_ppd_low, get_text("PPD Low", active_ppd_low), color=color.new(color.black, 100), textcolor=col_l, style=label.style_label_left, tooltip=get_text("PPD Low", active_ppd_low))

if timeframe.isintraday and not na(active_session_start_bar) and is_data_anchor_bar
    if show_5 and not na(l_sma5)
        line.set_x2(l_sma5, target_index)
        label.set_x(lbl_sma5, target_label_index)
    if show_10 and not na(l_sma10)
        line.set_x2(l_sma10, target_index)
        label.set_x(lbl_sma10, target_label_index)
    if show_20 and not na(l_sma20)
        line.set_x2(l_sma20, target_index)
        label.set_x(lbl_sma20, target_label_index)
    if show_50 and not na(l_sma50)
        line.set_x2(l_sma50, target_index)
        label.set_x(lbl_sma50, target_label_index)
    if show_150 and not na(l_sma150)
        line.set_x2(l_sma150, target_index)
        label.set_x(lbl_sma150, target_label_index)
    if show_200 and not na(l_sma200)
        line.set_x2(l_sma200, target_index)
        label.set_x(lbl_sma200, target_label_index)
    if show_ema10 and not na(l_ema10)
        line.set_x2(l_ema10, target_index)
        label.set_x(lbl_ema10, target_label_index)
    if show_ema20 and not na(l_ema20)
        line.set_x2(l_ema20, target_index)
        label.set_x(lbl_ema20, target_label_index)
    if show_ema50 and not na(l_ema50)
        line.set_x2(l_ema50, target_index)
        label.set_x(lbl_ema50, target_label_index)
    if show_h and not na(l_high)
        line.set_x2(l_high, target_index)
        label.set_x(lbl_high, target_label_index)
    if show_l and not na(l_low)
        line.set_x2(l_low, target_index)
        label.set_x(lbl_low, target_label_index)
    if show_ppd_low_line and not na(l_ppd_low)
        line.set_x2(l_ppd_low, target_index)
        label.set_x(lbl_ppd_low, target_label_index)

    if show_or5 and not na(active_or5_high) and level_is_relevant_at(active_or5_high, active_close, active_session_lod, active_session_hod)
        if na(l_or5h)
            l_or5h   := line.new(active_session_start_bar, active_or5_high, target_index, active_or5_high, color=col_or5, width=w_or5, style=get_style(style_or5))
            lbl_or5h := label.new(target_label_index, active_or5_high, "5m", color=color.new(color.black, 100), textcolor=col_or5, style=label.style_label_left, tooltip=get_text("5m OR High", active_or5_high))
        else
            line.set_xy1(l_or5h, active_session_start_bar, active_or5_high)
            line.set_xy2(l_or5h, target_index, active_or5_high)
            label.set_xy(lbl_or5h, target_label_index, active_or5_high)
            // keep label text in sync with the (possibly updated) OR high value
            label.set_text(lbl_or5h, "5m")

    if show_or30 and not na(active_or30_high) and level_is_relevant_at(active_or30_high, active_close, active_session_lod, active_session_hod)
        if na(l_or30h)
            l_or30h   := line.new(active_session_start_bar, active_or30_high, target_index, active_or30_high, color=col_or30, width=w_or30, style=get_style(style_or30))
            lbl_or30h := label.new(target_label_index, active_or30_high, "30m", color=color.new(color.black, 100), textcolor=col_or30, style=label.style_label_left, tooltip=get_text("30m OR High", active_or30_high))
        else
            line.set_xy1(l_or30h, active_session_start_bar, active_or30_high)
            line.set_xy2(l_or30h, target_index, active_or30_high)
            label.set_xy(lbl_or30h, target_label_index, active_or30_high)
            // keep label text in sync with the (possibly updated) OR high value
            label.set_text(lbl_or30h, "30m")

    // --- LABEL ALIGNMENT + ANTI-OVERLAP STAGGER (anchor bar only) ---
    // Keep each label at its real line price, then push only the x-position right
    // when nearby labels would collide.
    if is_data_anchor_bar
        sma5_y   = active_sma5_d
        sma10_y  = active_sma10_d
        sma20_y  = active_sma20_d
        sma50_y  = active_sma50_d
        sma150_y = active_sma150_d
        sma200_y = active_sma200_d
        ema10_y  = active_ema10_d
        ema20_y  = active_ema20_d
        ema50_y  = active_ema50_d

        if not na(lbl_sma5)
            label.set_y(lbl_sma5, sma5_y)
        if not na(lbl_sma10)
            label.set_y(lbl_sma10, sma10_y)
        if not na(lbl_sma20)
            label.set_y(lbl_sma20, sma20_y)
        if not na(lbl_sma50)
            label.set_y(lbl_sma50, sma50_y)
        if not na(lbl_sma150)
            label.set_y(lbl_sma150, sma150_y)
        if not na(lbl_sma200)
            label.set_y(lbl_sma200, sma200_y)
        if not na(lbl_ema10)
            label.set_y(lbl_ema10, ema10_y)
        if not na(lbl_ema20)
            label.set_y(lbl_ema20, ema20_y)
        if not na(lbl_ema50)
            label.set_y(lbl_ema50, ema50_y)

        if lbl_min_gap_pct > 0.0
            lns_arr    = array.new<line>()
            lbls_arr   = array.new<label>()
            prices_arr = array.new<float>()
            add_lbl(lns_arr, lbls_arr, prices_arr, l_low,     lbl_low,     active_prev_low)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_ppd_low, lbl_ppd_low, active_ppd_low)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_sma200,  lbl_sma200,  sma200_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_sma150,  lbl_sma150,  sma150_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_sma50,   lbl_sma50,   sma50_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_ema50,   lbl_ema50,   ema50_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_sma20,   lbl_sma20,   sma20_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_ema20,   lbl_ema20,   ema20_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_sma10,   lbl_sma10,   sma10_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_ema10,   lbl_ema10,   ema10_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_sma5,    lbl_sma5,    sma5_y)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_high,    lbl_high,    active_prev_high)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_or5h,    lbl_or5h,    active_or5_high)
            add_lbl(lns_arr, lbls_arr, prices_arr, l_or30h,   lbl_or30h,   active_or30_high)
            min_gap = active_close * (lbl_min_gap_pct / 100.0)
            stagger_labels(lns_arr, lbls_arr, prices_arr, min_gap, target_label_index, lbl_step_bars, lbl_max_slots, label_offset)

            if not na(lbl_or5h) and not na(lbl_or30h) and not na(l_or5h) and not na(l_or30h) and not na(active_or5_high) and not na(active_or30_high) and math.abs(active_or5_high - active_or30_high) < min_gap
                or5_x = target_label_index
                or30_x = target_label_index + lbl_step_bars
                label.set_x(lbl_or5h, or5_x)
                label.set_x(lbl_or30h, or30_x)
                line.set_x2(l_or5h, or5_x - label_offset)
                line.set_x2(l_or30h, or30_x - label_offset)


// --- DASHBOARD TABLE ---
table_size_sel = switch tbl_size
    'Tiny'   => size.tiny
    'Small'  => size.small
    'Normal' => size.normal
    'Large'  => size.large

// Fully transparent background to match the plain-text look of the ATR overlay in the corner.
// Column 0 is a thin empty padding column so the leftmost character isn't pressed
// against the pane edge (which was clipping the first digit of LoD Price).
var table top_tbl = table.new(position.top_right, 3, 4, bgcolor=color.new(color.black, 100))
var table bottom_tbl = table.new(position.bottom_right, 3, 3, bgcolor=color.new(color.black, 100))

if is_data_anchor_bar and show_info_table
    color_rvol = active_calc_rvol > 50.0 ? tbl_text_col : tbl_extended_col
    display_chart_lod = timeframe.isintraday ? chart_lod : na(active_chart_lod) ? low : active_chart_lod
    display_calc_lodd = timeframe.isintraday ? calc_lodd : chart_atr > 0 ? ((chart_close - display_chart_lod) / chart_atr) * 100 : na
    has_lod = (not timeframe.isintraday or (barstate.islast and session_lod_ready)) and not na(display_chart_lod) and not na(display_calc_lodd)
    color_lodd = has_lod and display_calc_lodd > 50.0 ? tbl_extended_col : tbl_text_col
    color_gain = active_calc_gain_from_ma >= 0.0 ? tbl_text_col : tbl_extended_col
    color_atr_mult = active_is_atr_extended ? tbl_extended_col : tbl_text_col

    str_rvol = str.tostring(active_calc_rvol, "0") + "%"
    str_lodd = has_lod ? str.tostring(display_calc_lodd, "0") + "%" : ""
    str_lodp = has_lod ? str.tostring(display_chart_lod, "#.##") : ""
    str_atr_mult = str.tostring(active_calc_atr_mult_from_ma, "0.00")
    str_gain_ma = str.tostring(active_calc_gain_from_ma, "0.00") + "%"
    str_atr_pct = str.tostring(active_calc_atr_pct, "0.00") + "%"

    // Empty padding column on the left.
    table.cell(top_tbl, 0, 0, " ", text_size=table_size_sel)
    table.cell(top_tbl, 1, 0, " ", text_size=table_size_sel)
    table.cell(top_tbl, 2, 0, " ", text_size=table_size_sel)

    table.cell(top_tbl, 0, 1, " ", text_size=table_size_sel)
    table.cell(top_tbl, 0, 2, " ", text_size=table_size_sel)
    table.cell(top_tbl, 0, 3, " ", text_size=table_size_sel)

    table.cell(top_tbl, 1, 1, "Rel Vol",       text_color=tbl_text_col, text_size=table_size_sel, text_halign=text.align_left)
    table.cell(top_tbl, 2, 1, str_rvol,         text_color=color_rvol,  text_size=table_size_sel, text_halign=text.align_right)

    table.cell(top_tbl, 1, 2, "LoD Distance",  text_color=tbl_text_col, text_size=table_size_sel, text_halign=text.align_left)
    table.cell(top_tbl, 2, 2, str_lodd,         text_color=color_lodd,  text_size=table_size_sel, text_halign=text.align_right)

    table.cell(top_tbl, 1, 3, "LoD Price",     text_color=tbl_text_col, text_size=table_size_sel, text_halign=text.align_left)
    table.cell(top_tbl, 2, 3, str_lodp,         text_color=tbl_text_col, text_size=table_size_sel, text_halign=text.align_right)

    table.cell(bottom_tbl, 0, 0, " ", text_size=table_size_sel)
    table.cell(bottom_tbl, 0, 1, " ", text_size=table_size_sel)
    table.cell(bottom_tbl, 0, 2, " ", text_size=table_size_sel)

    table.cell(bottom_tbl, 1, 0, "Multiple",              text_color=tbl_text_col,    text_size=table_size_sel, text_halign=text.align_left)
    table.cell(bottom_tbl, 2, 0, str_atr_mult,            text_color=color_atr_mult,  text_size=table_size_sel, text_halign=text.align_right)

    table.cell(bottom_tbl, 1, 1, "Gain%",                 text_color=tbl_text_col,    text_size=table_size_sel, text_halign=text.align_left)
    table.cell(bottom_tbl, 2, 1, str_gain_ma,             text_color=color_gain,      text_size=table_size_sel, text_halign=text.align_right)

    table.cell(bottom_tbl, 1, 2, "ATR%",                  text_color=tbl_text_col,    text_size=table_size_sel, text_halign=text.align_left)
    table.cell(bottom_tbl, 2, 2, str_atr_pct,             text_color=tbl_text_col,    text_size=table_size_sel, text_halign=text.align_right)
