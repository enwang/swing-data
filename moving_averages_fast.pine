// Optimized for the current Swing Data chart setup.
//@version=6
indicator("Moving Averages Fast", shorttitle="MA Fast", overlay=true)

line_width = input.int(1, "Line Width", minval=1, maxval=4)

group_daily = "Daily Moving Averages (also shown on intraday)"
show_daily_10ema = input.bool(true, "10 EMA", inline="d1", group=group_daily)
color_daily_10ema = input.color(color.rgb(214, 74, 74), "", inline="d1", group=group_daily)
show_daily_20ema = input.bool(true, "20 EMA", inline="d2", group=group_daily)
color_daily_20ema = input.color(color.rgb(240, 165, 35), "", inline="d2", group=group_daily)
show_daily_50ema = input.bool(true, "50 EMA", inline="d3", group=group_daily)
color_daily_50ema = input.color(color.rgb(65, 105, 225), "", inline="d3", group=group_daily)
show_daily_200sma = input.bool(true, "200 SMA", inline="d4", group=group_daily)
color_daily_200sma = input.color(color.rgb(91, 63, 191), "", inline="d4", group=group_daily)
show_daily_50sma = input.bool(true, "50 SMA", inline="d5", group=group_daily)
color_daily_50sma = input.color(color.rgb(156, 188, 232), "", inline="d5", group=group_daily)

group_weekly = "Weekly Moving Averages"
show_weekly_10ema = input.bool(true, "10 EMA", inline="w1", group=group_weekly)
color_weekly_10ema = input.color(color.rgb(214, 74, 74), "", inline="w1", group=group_weekly)
show_weekly_20ema = input.bool(true, "20 EMA", inline="w2", group=group_weekly)
color_weekly_20ema = input.color(color.rgb(240, 165, 35), "", inline="w2", group=group_weekly)
show_weekly_40ema = input.bool(true, "40 EMA", inline="w3", group=group_weekly)
color_weekly_40ema = input.color(color.rgb(65, 105, 225), "", inline="w3", group=group_weekly)
show_weekly_200ema = input.bool(true, "200 EMA", inline="w4", group=group_weekly)
color_weekly_200ema = input.color(color.rgb(91, 63, 191), "", inline="w4", group=group_weekly)

group_monthly = "Monthly Moving Averages"
show_monthly_10sma = input.bool(true, "10 SMA", inline="m1", group=group_monthly)
color_monthly_10sma = input.color(color.rgb(146, 149, 157), "", inline="m1", group=group_monthly)

is_intra = timeframe.isintraday
is_daily = timeframe.isdaily
is_weekly = timeframe.isweekly
is_monthly = timeframe.ismonthly

[stable_daily_10ema, stable_daily_20ema, stable_daily_50ema, stable_daily_200sma, stable_daily_50sma] = request.security(syminfo.tickerid, "D", [ta.ema(close, 10)[1], ta.ema(close, 20)[1], ta.ema(close, 50)[1], ta.sma(close, 200)[1], ta.sma(close, 50)[1]], lookahead=barmerge.lookahead_on)

plot(is_intra and show_daily_10ema ? stable_daily_10ema : na, "Stable Daily 10 EMA", color_daily_10ema, line_width)
plot(is_intra and show_daily_20ema ? stable_daily_20ema : na, "Stable Daily 20 EMA", color_daily_20ema, line_width)
plot(is_intra and show_daily_50ema ? stable_daily_50ema : na, "Stable Daily 50 EMA", color_daily_50ema, line_width)
plot(is_intra and show_daily_200sma ? stable_daily_200sma : na, "Stable Daily 200 SMA", color_daily_200sma, line_width)
plot(is_intra and show_daily_50sma ? stable_daily_50sma : na, "Stable Daily 50 SMA", color_daily_50sma, line_width)

plot(is_daily and show_daily_10ema ? ta.ema(close, 10) : na, "Daily 10 EMA", color_daily_10ema, line_width)
plot(is_daily and show_daily_20ema ? ta.ema(close, 20) : na, "Daily 20 EMA", color_daily_20ema, line_width)
plot(is_daily and show_daily_50ema ? ta.ema(close, 50) : na, "Daily 50 EMA", color_daily_50ema, line_width)
plot(is_daily and show_daily_200sma ? ta.sma(close, 200) : na, "Daily 200 SMA", color_daily_200sma, line_width)
plot(is_daily and show_daily_50sma ? ta.sma(close, 50) : na, "Daily 50 SMA", color_daily_50sma, line_width)

plot(is_weekly and show_weekly_10ema ? ta.ema(close, 10) : na, "Weekly 10 EMA", color_weekly_10ema, line_width)
plot(is_weekly and show_weekly_20ema ? ta.ema(close, 20) : na, "Weekly 20 EMA", color_weekly_20ema, line_width)
plot(is_weekly and show_weekly_40ema ? ta.ema(close, 40) : na, "Weekly 40 EMA", color_weekly_40ema, line_width)
plot(is_weekly and show_weekly_200ema ? ta.ema(close, 200) : na, "Weekly 200 EMA", color_weekly_200ema, line_width)

plot(is_monthly and show_monthly_10sma ? ta.sma(close, 10) : na, "Monthly 10 SMA", color_monthly_10sma, line_width)
